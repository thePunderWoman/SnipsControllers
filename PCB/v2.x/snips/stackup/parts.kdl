// Snips-specific parts: the XBee 3 carrier pads. Reusable parts come from the @stackup library.

// Pads for the optional XBee 3 carrier, a separate 2-layer daughter board that sits flat on the underside and is
// hand-soldered by its castellations. Pads run 1.7 mm past the board's 22 x 17 mm outline for the iron. The carrier
// holds the XBee's decoupling, the RESET pull-up and RC, and the ATTN/BOOTMODE pull-up. VCC draw is the XBee 3 PRO's
// 140 mA at +19 dBm (Digi 90001543). DIN is the XBee's input and DOUT its output, so the ESP32 transmits on DIN.
part xbee-carrier {
    symbol "Connector_Generic:Conn_02x06_Odd_Even"
    reference U
    value "XBee carrier"
    description "Solder pads for the Snips XBee 3 castellated daughter board, 22x17mm"

    pin GND power_in
    pin VCC power_in
    pin DIN input
    pin DOUT output
    pin RTS input
    pin CTS output
    pin SLEEP_RQ input
    pin ON_SLEEP output
    pin RESET input

    package castellated footprint="SnipsControllers_Custom:XBee_Carrier_Castellated" {
        pad CTS 1
        pad DIN 2
        pad DOUT 3
        pad RTS 4
        pad ON_SLEEP 5
        pad RESET 6
        pad SLEEP_RQ 7
        pad GND 8
        pad VCC 9
        pad VCC 10
        pad GND 11
        pad GND 12
    }

    port vcc type=power {
        require net.voltage min="2.1V" max="3.6V"
        add net.draw "140mA"
        line rail pin=VCC
        line gnd pin=GND
    }
}
