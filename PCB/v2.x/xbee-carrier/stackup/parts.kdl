// The carrier's castellated edge, the mate of xbee-carrier on the V2 board. Same pad numbers and coordinates.
part carrier-edge {
    symbol "Connector_Generic:Conn_02x06_Odd_Even"
    reference J
    value "XBee carrier edge"
    description "Castellated half holes on the carrier's edge, 2.54 mm pitch"

    pin GND power_in
    pin VCC power_in
    pin DIN passive
    pin DOUT passive
    pin RTS passive
    pin CTS passive
    pin SLEEP_RQ passive
    pin ON_SLEEP passive
    pin RESET passive

    package castellated footprint="SnipsControllers_Custom:XBee_Carrier_Edge" {
        pad CTS 1
        pad DIN 2
        pad DOUT 3
        pad RTS 4
        pad ON_SLEEP 5
        pad RESET 6
        pad SLEEP_RQ 7
        pad GND 8
        pad VCC 9
        pad VCC 10
        pad GND 11
        pad GND 12
    }
}
