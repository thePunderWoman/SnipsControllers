// Snips Controller electrical definition. Artwork and placement live in the PCB.
use "@stackup/connector/jst-ph"
use "@stackup/connector/qwiic"
use "@stackup/connector/usb-c"
use "@stackup/discrete/bjt/mmbt3904"
use "@stackup/discrete/diode/bat54w"
use "@stackup/discrete/diode/diode"
use "@stackup/discrete/diode/tvs"
use "@stackup/discrete/fet/ao3400a"
use "@stackup/discrete/fet/ao3401a"
use "@stackup/mechanical"
use "@stackup/passives"
use "@stackup/power/buck/tlv62569"
use "@stackup/power/charger/bq25185"
use "@stackup/switch/push-button"
use "./parts.kdl"; use "./purchasing.kdl"

design snips_controller {
    // Components
    place jst-ph-2 "BT1" designator="BT1" footprint="Connector_JST:JST_PH_S2B-PH-K_1x02_P2.00mm_Horizontal" value="PH 2-pin battery RIGHT-ANGLE HORIZONTAL" bom_value="JST PH 2-pin 2mm | S2B-PH-K(LF)(SN) | JST | Through-hole | RIGHT-ANGLE HORIZONTAL not vertical"
    place capacitor "C_MCU_1" designator="C_MCU_1" footprint="Capacitor_SMD:C_0603_1608Metric" value="10µF" bom_value="10µF 10V X5R ±10% | CL10A106KP8NNNC | Samsung | 0603"
    place capacitor "C_MCU_2" designator="C_MCU_2" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_MCU_3" designator="C_MCU_3" footprint="Capacitor_SMD:C_0402_1005Metric" value="39pF" bom_value="39pF 50V NP0 ±5% | CC0402JRNPO9BN390 | Yageo | 0402"
    place capacitor "C_BAT1" designator="C_BAT1" footprint="Capacitor_SMD:C_0805_2012Metric" value="10µF" bom_value="10µF 25V X5R ±10% | CL21A106KAYNNNE | Samsung | 0805"
    place capacitor "C_BUCK_IN1" designator="C_BUCK_IN1" footprint="Capacitor_SMD:C_0805_2012Metric" value="10µF" bom_value="10µF 25V X5R ±10% | CL21A106KAYNNNE | Samsung | 0805"
    place capacitor "C_BUCK_OUT1" designator="C_BUCK_OUT1" footprint="Capacitor_SMD:C_0805_2012Metric" value="22µF" bom_value="22µF 25V X5R ±20% | CL21A226MAQNNNE | Samsung | 0805"
    place capacitor "C_EN1" designator="C_EN1" footprint="Capacitor_SMD:C_0603_1608Metric" value="1µF" bom_value="1µF 50V X5R ±10% | CL10A105KB8NNNC | Samsung | 0603"
    place capacitor "C_DBNC1" designator="C_DBNC1" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_IMU_1" designator="C_IMU_1" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_IMU_2" designator="C_IMU_2" footprint="Capacitor_SMD:C_0603_1608Metric" value="2.2µF" bom_value="2.2µF 10V X7R ±10% | CL10B225KP8NNNC | Samsung | 0603"
    place capacitor "C_IMU_3" designator="C_IMU_3" footprint="Capacitor_SMD:C_0402_1005Metric" value="10nF" bom_value="10nF 50V X7R ±10% | CL05B103KB5NNNC | Samsung | 0402"
    place capacitor "C_HALL1" designator="C_HALL1" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_LATCH_G1" designator="C_LATCH_G1" footprint="Capacitor_SMD:C_0402_1005Metric" value="1µF" bom_value="1µF 6.3V X5R ±10% | CL05A105KQ5NNNC | Samsung | 0402"
    place capacitor "C_OLED_1" designator="C_OLED_1" footprint="Capacitor_SMD:C_0603_1608Metric" value="1µF" bom_value="1µF 50V X5R ±10% | CL10A105KB8NNNC | Samsung | 0603"
    place capacitor "C_OLED_2" designator="C_OLED_2" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_RGB1" designator="C_RGB1" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_STICK1" designator="C_STICK1" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_SYS_1" designator="C_SYS_1" footprint="Capacitor_SMD:C_0805_2012Metric" value="10µF" bom_value="10µF 25V X5R ±10% | CL21A106KAYNNNE | Samsung | 0805"
    place capacitor "C_SYS_2" designator="C_SYS_2" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_VSYS1" designator="C_VSYS1" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place capacitor "C_VIN_1" designator="C_VIN_1" footprint="Capacitor_SMD:C_0805_2012Metric" value="10µF" bom_value="10µF 25V X5R ±10% | CL21A106KAYNNNE | Samsung | 0805"
    place capacitor "C_VIN_2" designator="C_VIN_2" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place bat54w "D_INV_ISO1" designator="D_INV_ISO1" footprint="Package_TO_SOT_SMD:SOT-323_SC-70" value="BAT54W-7-F" bom_value="Schottky diode 30V 200mA | BAT54W-7-F | Diodes Inc | SOT-323"
    place diode "D_OR1" designator="D_OR1" footprint="Diode_SMD:D_SOD-123" value="1N4148W" bom_value="1N4148W switching diode 75V 150mA | 1N4148W | ST | SOD-123"
    place diode "D_OR2" designator="D_OR2" footprint="Diode_SMD:D_SOD-123" value="1N4148W" bom_value="1N4148W switching diode 75V 150mA | 1N4148W | ST | SOD-123"
    place sk6812mini-hs "D_RGB1" designator="D_RGB1" footprint="SnipsControllers_Custom:SK6812MINI-HS-012" value="SK6812MINI-HS-012" bom_value="Addressable RGB LED | SK6812MINI-HS | OPSCO | 3.5x3.5mm SMD | top-mount lens up" {
        ignore "vdd.net.voltage" reason="run at 3.3V like the MINI-E it replaces" // Datasheet minimum: 3.7 V; this board supplies 3.3 V.
    }
    place tvs "D_VBUS_TVS1" designator="D_VBUS_TVS1" footprint="Diode_SMD:D_SOD-323" value="TPPESD5V0S1BA" bom_value="TVS diode 5V bidirectional | TPPESD5V0S1BA | TECH PUBLIC | SOD-323"
    place component_J_STICK1 "J_STICK1" designator="J_STICK1" footprint="SnipsControllers_Custom:GuliKit_HallStick" value="GuliKit_Thumbstick" bom_value="Hall thumbstick | GuliKit_Thumbstick | GuliKit | Through-hole | DNP - hand-fitted - do not assemble" hand=#true
    place usb-c-receptacle "J_USB1" designator="J_USB1" footprint="Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12" package="hro" value="USB-C" bom_value="USB-C receptacle 16-pin | TYPE-C-31-M-12 | Hroparts Elec | SMD with through-hole shell tabs | right-angle"
    place inductor "L_BUCK1" designator="L_BUCK1" footprint="Inductor_SMD:L_Bourns-SRN4018" value="2.2µH" bom_value="2.2µH ±20% 2.9A 44mΩ power inductor | SRN4018-2R2M | Bourns | SMD 4x4mm"
    place mmbt3904 "Q_INV1" designator="Q_INV1" footprint="Package_TO_SOT_SMD:SOT-23" value="MMBT3904(RANGE:100-300)" bom_value="NPN transistor 40V 200mA hFE 100-300 | MMBT3904(RANGE:100-300) | JCET | SOT-23"
    place nfet-ao3400a "Q_LATCH1" designator="Q_LATCH1" footprint="Package_TO_SOT_SMD:SOT-23" value="AO3400A" bom_value="N-channel MOSFET 30V 5.7A | AO3400A | AOS | SOT-23"
    place ao3401a "Q_PWR1" designator="Q_PWR1" footprint="Package_TO_SOT_SMD:SOT-23" value="AO3401A" bom_value="P-channel MOSFET 30V 4A | AO3401A | AOS | SOT-23"
    place resistor "R_BOOT_PU1" designator="R_BOOT_PU1" footprint="Resistor_SMD:R_0402_1005Metric" value="10kΩ" bom_value="10kΩ ±1% 62.5mW | 0402WGF1002TCE | UNI-ROYAL | 0402"
    place resistor "R_BTN_PU1" designator="R_BTN_PU1" footprint="Resistor_SMD:R_0402_1005Metric" value="100kΩ" bom_value="100kΩ ±1% 62.5mW | 0402WGF1003TCE | UNI-ROYAL | 0402"
    place resistor "R_CC1" designator="R_CC1" footprint="Resistor_SMD:R_0402_1005Metric" value="5.1kΩ" bom_value="5.1kΩ ±1% 62.5mW | 0402WGF5101TCE | UNI-ROYAL | 0402"
    place resistor "R_CC2" designator="R_CC2" footprint="Resistor_SMD:R_0402_1005Metric" value="5.1kΩ" bom_value="5.1kΩ ±1% 62.5mW | 0402WGF5101TCE | UNI-ROYAL | 0402"
    place resistor "R_EN_PU1" designator="R_EN_PU1" footprint="Resistor_SMD:R_0402_1005Metric" value="10kΩ" bom_value="10kΩ ±1% 62.5mW | 0402WGF1002TCE | UNI-ROYAL | 0402"
    place resistor "R_FB1" designator="R_FB1" footprint="Resistor_SMD:R_0402_1005Metric" value="255kΩ" bom_value="255kΩ ±1% 62.5mW | RC0402FR-07255KL | Yageo | 0402"
    place resistor "R_FB2" designator="R_FB2" footprint="Resistor_SMD:R_0402_1005Metric" value="56.2kΩ" bom_value="56.2kΩ ±1% 62.5mW | RC0402FR-0756K2L | Yageo | 0402"
    place resistor "R_GATE1" designator="R_GATE1" footprint="Resistor_SMD:R_0402_1005Metric" value="100kΩ" bom_value="100kΩ ±1% 62.5mW | 0402WGF1003TCE | UNI-ROYAL | 0402"
    place resistor "R_INV_BASE1" designator="R_INV_BASE1" footprint="Resistor_SMD:R_0402_1005Metric" value="220kΩ" bom_value="220kΩ ±1% 62.5mW | 0402WGF2203TCE | UNI-ROYAL | 0402"
    place resistor "R_INV_PU1" designator="R_INV_PU1" footprint="Resistor_SMD:R_0402_1005Metric" value="220kΩ" bom_value="220kΩ ±1% 62.5mW | 0402WGF2203TCE | UNI-ROYAL | 0402"
    place resistor "R_ISET1" designator="R_ISET1" footprint="Resistor_SMD:R_0402_1005Metric" value="604Ω" bom_value="604Ω ±1% 62.5mW | AC0402FR-07604RL | Yageo | 0402"
    place resistor "R_LATCH_G1" designator="R_LATCH_G1" footprint="Resistor_SMD:R_0402_1005Metric" value="1MΩ" bom_value="1MΩ ±1% 62.5mW | 0402WGF1004TCE | UNI-ROYAL | 0402"
    place pull-down "R_PWR_EN_PD1" designator="R_PWR_EN_PD1" footprint="Resistor_SMD:R_0402_1005Metric" value="100kΩ" bom_value="100kΩ ±1% 62.5mW | 0402WGF1003TCE | UNI-ROYAL | 0402"
    place resistor "R_RGB1" designator="R_RGB1" footprint="Resistor_SMD:R_0402_1005Metric" value="470Ω" bom_value="470Ω ±1% 62.5mW | 0402WGF4700TCE | UNI-ROYAL | 0402"
    place resistor "R_STAT1" designator="R_STAT1" footprint="Resistor_SMD:R_0402_1005Metric" value="10kΩ" bom_value="10kΩ ±1% 62.5mW | 0402WGF1002TCE | UNI-ROYAL | 0402"
    place resistor "R_STAT2" designator="R_STAT2" footprint="Resistor_SMD:R_0402_1005Metric" value="10kΩ" bom_value="10kΩ ±1% 62.5mW | 0402WGF1002TCE | UNI-ROYAL | 0402"
    place resistor "R_TS1" designator="R_TS1" footprint="Resistor_SMD:R_0402_1005Metric" value="10kΩ" bom_value="10kΩ ±1% 62.5mW | 0402WGF1002TCE | UNI-ROYAL | 0402"
    place resistor "R_USB_DM1" designator="R_USB_DM1" footprint="Resistor_SMD:R_0402_1005Metric" value="27Ω" bom_value="27Ω ±1% 62.5mW | RC0402FR-0727RL | Yageo | 0402"
    place resistor "R_USB_DP1" designator="R_USB_DP1" footprint="Resistor_SMD:R_0402_1005Metric" value="27Ω" bom_value="27Ω ±1% 62.5mW | RC0402FR-0727RL | Yageo | 0402"
    place resistor "R_VSET1" designator="R_VSET1" footprint="Resistor_SMD:R_0402_1005Metric" value="18kΩ" bom_value="18kΩ ±1% 62.5mW | RC0402FR-0718KL | Yageo | 0402"
    place resistor "R_VSYS1" designator="R_VSYS1" footprint="Resistor_SMD:R_0402_1005Metric" value="200kΩ" bom_value="200kΩ ±1% 62.5mW | 0402WGF2003TCE | UNI-ROYAL | 0402"
    place resistor "R_VSYS2" designator="R_VSYS2" footprint="Resistor_SMD:R_0402_1005Metric" value="100kΩ" bom_value="100kΩ ±1% 62.5mW | 0402WGF1003TCE | UNI-ROYAL | 0402"
    place skrp-button "SW_BOOT1" designator="SW_BOOT1" footprint="SnipsControllers_Custom:SW_Alps_SKRP" value="SKRPABE010" bom_value="Tact switch 1.6N 100k cycles | SKRPABE010 | Alps | SMD 4.2x3.2x2.5mm | top actuated"
    place skrp-button "SW_MACRO1" designator="SW_MACRO1" footprint="SnipsControllers_Custom:SW_Alps_SKRP" value="SKRPABE010" bom_value="Tact switch 1.6N 100k cycles | SKRPABE010 | Alps | SMD 4.2x3.2x2.5mm | top actuated"
    place skrp-button "SW_MACRO2" designator="SW_MACRO2" footprint="SnipsControllers_Custom:SW_Alps_SKRP" value="SKRPABE010" bom_value="Tact switch 1.6N 100k cycles | SKRPABE010 | Alps | SMD 4.2x3.2x2.5mm | top actuated"
    place skrp-button "SW_MACRO3" designator="SW_MACRO3" footprint="SnipsControllers_Custom:SW_Alps_SKRP" value="SKRPABE010" bom_value="Tact switch 1.6N 100k cycles | SKRPABE010 | Alps | SMD 4.2x3.2x2.5mm | top actuated"
    place skrp-button "SW_MACRO4" designator="SW_MACRO4" footprint="SnipsControllers_Custom:SW_Alps_SKRP" value="SKRPABE010" bom_value="Tact switch 1.6N 100k cycles | SKRPABE010 | Alps | SMD 4.2x3.2x2.5mm | top actuated"
    place skrp-button "SW_MACRO5" designator="SW_MACRO5" footprint="SnipsControllers_Custom:SW_Alps_SKRP" value="SKRPABE010" bom_value="Tact switch 1.6N 100k cycles | SKRPABE010 | Alps | SMD 4.2x3.2x2.5mm | top actuated"
    place skrp-button "SW_MACRO6" designator="SW_MACRO6" footprint="SnipsControllers_Custom:SW_Alps_SKRP" value="SKRPABE010" bom_value="Tact switch 1.6N 100k cycles | SKRPABE010 | Alps | SMD 4.2x3.2x2.5mm | top actuated"
    place push-button "SW_PWR1" designator="SW_PWR1" footprint="Button_Switch_SMD:SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010" package="alps" value="SKRTLAE010" bom_value="Side-push tact switch 1.6N 100k cycles | SKRTLAE010 | Alps | SMD 4.5x3.4x3.3mm | right-angle"
    place push-button "SW_THR_DN1" designator="SW_THR_DN1" footprint="Button_Switch_SMD:SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010" package="alps" value="SKRTLAE010" bom_value="Side-push tact switch 1.6N 100k cycles | SKRTLAE010 | Alps | SMD 4.5x3.4x3.3mm | right-angle"
    place push-button "SW_THR_UP1" designator="SW_THR_UP1" footprint="Button_Switch_SMD:SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010" package="alps" value="SKRTLAE010" bom_value="Side-push tact switch 1.6N 100k cycles | SKRTLAE010 | Alps | SMD 4.5x3.4x3.3mm | right-angle"
    place push-button "SW_TRIG_DIG1" designator="SW_TRIG_DIG1" footprint="Button_Switch_SMD:SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010" package="alps" value="SKRTLAE010" bom_value="Side-push tact switch 1.6N 100k cycles | SKRTLAE010 | Alps | SMD 4.5x3.4x3.3mm | right-angle"
    place push-button "SW_VOL_DN1" designator="SW_VOL_DN1" footprint="Button_Switch_SMD:SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010" package="alps" value="SKRTLAE010" bom_value="Side-push tact switch 1.6N 100k cycles | SKRTLAE010 | Alps | SMD 4.5x3.4x3.3mm | right-angle"
    place push-button "SW_VOL_UP1" designator="SW_VOL_UP1" footprint="Button_Switch_SMD:SW_Push_1P1T-MP_NO_Horizontal_Alps_SKRTLAE010" package="alps" value="SKRTLAE010" bom_value="Side-push tact switch 1.6N 100k cycles | SKRTLAE010 | Alps | SMD 4.5x3.4x3.3mm | right-angle"
    place tlv62569 "U_BUCK1" designator="U_BUCK1" footprint="Package_TO_SOT_SMD:SOT-23-5" value="TLV62569DBVR" bom_value="Adjustable buck converter 2A | TLV62569DBVR | TI | SOT-23-5"
    place bq25185 "U_CHG1" designator="U_CHG1" footprint="BQ25185DLHR:IC_BQ25185DLHR" value="BQ25185DLHR" bom_value="1-cell Li-ion charger 1A | BQ25185DLHR | TI | WSON-10" { without program; without always-enabled; without ts-fixed; without thermal; without supply }
    // Reflows on the last pass, on top: Espressif requires a single reflow for the module. The MINI-1U fits the
    // 17.5 mm between the macro row and the USB pads, where the 19.2 mm WROOM-1U does not.
    // Turned 270 degrees so the signal pins face the stick, the OLED and the carrier, and the GND edge faces the side.
    // Pins are assigned by position, not from V1's map. PWR_HOLD is on IO3, which has no reset pull (ESP32-S3
    // datasheet Table 2-1): RXD0's pull-up could re-latch the board as the rail collapses at power-off. C_LATCH_G1
    // carries the latch through a short reset, and firmware holds the pin with gpio_hold_en for USB uploads. It has
    // to be an RTC pad: on V1 hardware IO3 held through a full upload, and IO42, a digital pad, lost its hold.
    place esp32-s3-mini-1u "U_MCU1" designator="U_MCU1" footprint="Espressif:ESP32-S3-MINI-1U" value="ESP32-S3-MINI-1U-N8" bom_value="Wi-Fi BLE module 8MB flash no PSRAM | ESP32-S3-MINI-1U-N8 | Espressif | SMD module 15.4x15.4mm | N8 variant with external antenna connector"
    // Optional XBee 3 daughter board, hand-soldered to these pads by its castellations. It carries the XBee's
    // decoupling, the RESET pull-up and RC, and the ATTN/BOOTMODE pull-up, so nothing here depends on it being fitted.
    place xbee-carrier "U_XBEE1" designator="U_XBEE1" footprint="SnipsControllers_Custom:XBee_Carrier_Castellated" value="XBee carrier" bom_value="XBee carrier pads no part | Snips XBee carrier | Snips Controllers | Copper pads only | DNP - hand-soldered daughter board - do not assemble" manufacturer="Snips Controllers" mpn="Snips XBee carrier" hand=#true
    place resistor "R_I2C_SCL1" designator="R_I2C_SCL1" footprint="Resistor_SMD:R_0402_1005Metric" value="4.7kΩ" bom_value="4.7kΩ ±1% 62.5mW | 0402WGF4701TCE | UNI-ROYAL | 0402"
    place resistor "R_I2C_SDA1" designator="R_I2C_SDA1" footprint="Resistor_SMD:R_0402_1005Metric" value="4.7kΩ" bom_value="4.7kΩ ±1% 62.5mW | 0402WGF4701TCE | UNI-ROYAL | 0402"
    // Low-pass for the trigger, with C_TRIG1 at the ADC pin. The DRV5055 must not see a capacitor on OUT without a resistor.
    place resistor "R_TRIG1" designator="R_TRIG1" footprint="Resistor_SMD:R_0402_1005Metric" value="1kΩ" bom_value="1kΩ ±1% 62.5mW | 0402WGF1001TCE | UNI-ROYAL | 0402"
    place capacitor "C_TRIG1" designator="C_TRIG1" footprint="Capacitor_SMD:C_0402_1005Metric" value="100nF" bom_value="100nF 16V X7R ±10% | CL05B104KO5NNNC | Samsung | 0402"
    place drv5055a2-sot23 "U_HALL1" designator="U_HALL1" footprint="Package_TO_SOT_SMD:SOT-23" value="DRV5055A2QDBZR" bom_value="Linear hall sensor A2 ±42mT | DRV5055A2QDBZR | TI | SOT-23"
    place icm42670p "U_IMU1" designator="U_IMU1" footprint="Package_LGA:LGA-14_3x2.5mm_P0.5mm_LayoutBorder3x4y" value="ICM-42670-P" bom_value="6-axis IMU | ICM-42670-P | TDK InvenSense | LGA-14 2.5x3mm"
    place qwiic "U_OLED1" designator="U_OLED1" footprint="Connector_JST:JST_SH_SM04B-SRSS-TB_1x04-1MP_P1.00mm_Horizontal" value="Qwiic connector" bom_value="JST SH 4-pin 1mm Qwiic | SM04B-SRSS-TB(LF)(SN) | JST | SMD | side entry right-angle" { without tab }

    // Electrical nets
    circuit "U_MCU1.USB_D-" "R_USB_DM1.B" name="/MCU_Core/USB_DM_MCU"
    circuit "R_USB_DM1.A" "J_USB1.D-" name="/MCU_Core/USB_DM"
    circuit "U_MCU1.USB_D+" "R_USB_DP1.B" name="/MCU_Core/USB_DP_MCU"
    circuit "R_USB_DP1.A" "J_USB1.D+" name="/MCU_Core/USB_DP"
    circuit "C_EN1.A" "R_EN_PU1.A" "U_MCU1.EN" name="/MCU_Core/MCU_EN"
    circuit "R_I2C_SCL1.B" "U_IMU1.AP_SCL" "U_MCU1.IO13" "U_OLED1.4" name="/Accelerometer/I2C_SCL"
    circuit "R_I2C_SDA1.B" "U_IMU1.AP_SDA" "U_MCU1.IO12" "U_OLED1.3" name="/Accelerometer/I2C_SDA"
    circuit "SW_MACRO1.1" "U_MCU1.IO16" name="/Buttons_Direct/BTN_MACRO1"
    circuit "SW_MACRO2.1" "U_MCU1.IO5" name="/Buttons_Direct/BTN_MACRO2"
    circuit "SW_MACRO3.1" "U_MCU1.IO4" name="/Buttons_Direct/BTN_MACRO3"
    circuit "SW_MACRO4.1" "U_MCU1.IO11" name="/Buttons_Direct/BTN_MACRO4"
    circuit "SW_MACRO5.1" "U_MCU1.IO8" name="/Buttons_Direct/BTN_MACRO5"
    circuit "SW_MACRO6.1" "U_MCU1.IO2" name="/Buttons_Direct/BTN_MACRO6"
