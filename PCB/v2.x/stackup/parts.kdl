        pad P1_05 "D6"
        pad P1_07 "E0"
        pad P0_20 "E1"
        pad P0_21 "E2"
        pad P1_09 "E3"
        pad USB_DP "E4"
        pad USB_DM "E5"
        pad P0_12 "E6"
        pad GND "F0"
